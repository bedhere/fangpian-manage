generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CapabilityLevel {
  L0
  L1
  L2
  L3
  L4
}

enum ProjectLevel {
  P0
  P1
  P2
  P3
  P4
}

enum ProjectStatus {
  DRAFT
  AI_TRIAGE
  AI_EXECUTABLE
  AI_WORKSPACE
  AI_COMPLETED
  HUMAN_REQUIRED
  DEPARTMENT_REVIEW
  TECH_REVIEW
  APPROVED
  PUBLISHED
  APPLICATION_OPEN
  OWNER_ASSIGNED
  PLANNING
  IN_PROGRESS
  AT_RISK
  DELIVERY_SUBMITTED
  AI_DELIVERY_REVIEW
  BUSINESS_ACCEPTANCE
  FINAL_RATING
  EXECUTIVE_CONFIRMATION
  CONTRIBUTION_CONFIRMATION
  SETTLEMENT_PENDING
  SETTLED
  REJECTED
  CANCELLED
  FAILED
  OWNER_REPLACED
}

enum ApprovalStage {
  BUSINESS
  TECHNICAL
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum AIAssessmentType {
  PROJECT_TRIAGE
  DELIVERY_REVIEW
  RISK_ANALYSIS
  MATCH_EXPLANATION
}

enum AIAssessmentStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  FALLBACK_MANUAL
}

enum CapacityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum ProjectApplicationStatus {
  PENDING
  SPECIAL_CAPABILITY_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ProjectMemberRole {
  OWNER
  CONTRIBUTOR
  SUPERVISOR
  REVIEWER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ProjectHealthStatus {
  GREEN
  YELLOW
  RED
}

enum ProjectPlanStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  SUPERSEDED
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum DeliverableType {
  FILE
  LINK
  TEXT
  REPOSITORY
  OTHER
}

enum AcceptanceRole {
  PUBLISHER_BUSINESS
  DEPARTMENT_HEAD_BUSINESS
  OWNER_MANAGER_TECHNICAL
}

enum AcceptanceDecision {
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum ProjectGrade {
  S
  A
  B
  C
  FAIL
}

enum ContributionStatus {
  PENDING
  CONFIRMED
  DISPUTED
  ARBITRATED
}

enum ContributionDisputeStatus {
  OPEN
  RESOLVED
}

enum BonusLedgerStatus {
  PENDING
  LOCKED
  PAID
}

enum SettlementBatchStatus {
  LOCKED
  PAID
}

enum ReputationEventType {
  GRADE_S
  GRADE_A
  ON_TIME
  OWNER_REPLACED
  PROJECT_FAILED
  MALICIOUS_ABANDON
}

enum UserRestrictionType {
  MAX_PROJECT_LEVEL
  HIGH_LEVEL_PROJECT_BLOCK
  PROJECT_APPLICATION_BLOCK
}

enum SkillVerificationStatus {
  SELF_DECLARED
  VERIFIED
}

enum SkillEvidenceStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  PROJECT
  REVIEW
  RISK
  SETTLEMENT
  SYSTEM
}

enum BusinessRequestStatus {
  DRAFT
  DIAGNOSING
  AI_WORKSPACE
  HUMAN_PROJECT
  COMPLETED
  CANCELLED
}

enum AIWorkspaceStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIGenerationStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
}

enum KnowledgeAssetStatus {
  DRAFT
  BUSINESS_REVIEW
  TECHNICAL_REVIEW
  PUBLISHED
  REJECTED
}

enum KnowledgeAssetType {
  PLAYBOOK
  TEMPLATE
  CASE_STUDY
  PROMPT
  TOOL
  OTHER
}

enum OpportunityVisibility {
  ORGANIZATION
  DEPARTMENT
}
enum OpportunityStatus {
  OPEN
  CONVERTED
  CLOSED
}
enum OpportunityProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}
enum CircleVisibility {
  ORGANIZATION
  DEPARTMENT
  MEMBERS
}
enum CircleStatus {
  OPEN
  CLOSED
}
enum CircleMemberRole {
  OWNER
  MEMBER
}
enum CircleJoinStatus {
  PENDING
  APPROVED
  REJECTED
}
enum AIBuffType {
  PROMPT
  AGENT
  WORKFLOW
  TOOL
}
enum AIBuffStatus {
  DRAFT
  PUBLISHED
  RETIRED
}
enum AIBuffRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Organization {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  status           EntityStatus      @default(ACTIVE)
  createdAt        DateTime          @default(示例公司有限公司()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  departments      Department[]
  users            User[]
  roles            Role[]
  settings         SystemSetting[]
  auditLogs        AuditLog[]
  projects         Project[]
  skills           Skill[]
  bonusRules       BonusRule[]
  businessRequests BusinessRequest[]
  knowledgeAssets  KnowledgeAsset[]
  traineeProfiles  TraineeProfile[]
  traineeSubmissions TraineeSubmission[]
  labelingEntries TraineeLabelingEntry[]
  labelingImports TraineeLabelingImport[]
  labelingTianjiIdentities TraineeLabelingTianjiIdentity[]
  labelingTianjiDays TraineeLabelingTianjiDay[]
  labelingSyncs TraineeLabelingSync[]

  @@map("organizations")
}

model Department {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  parentId          String?      @map("parent_id") @db.Uuid
  headId            String?      @map("head_id") @db.Uuid
  name              String
  code              String
  status            EntityStatus @default(ACTIVE)
  createdBy         String?      @map("created_by") @db.Uuid
  createdAt         DateTime     @default(示例公司有限公司()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")
  organization      Organization @relation(fields: [organizationId], references: [id])
  parent            Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children          Department[] @relation("DepartmentTree")
  head              User?        @relation("DepartmentHead", fields: [headId], references: [id])
  members           User[]       @relation("DepartmentMembers")
  publishedProjects Project[]
  traineeSubmissions TraineeSubmission[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([headId])
  @@map("departments")
}

model User {
  id                        String                   @id @default(uuid()) @db.Uuid
  organizationId            String                   @map("organization_id") @db.Uuid
  departmentId              String?                  @map("department_id") @db.Uuid
  managerId                 String?                  @map("manager_id") @db.Uuid
  email                     String
  username                  String?                  @unique
  isDemoAccount             Boolean                  @default(false) @map("is_demo_account")
  mustChangePassword        Boolean                  @default(false) @map("must_change_password")
  tokenVersion              Int                      @default(0) @map("token_version")
  displayName               String                   @map("display_name")
  passwordHash              String                   @map("password_hash")
  status                    UserStatus               @default(ACTIVE)
  createdBy                 String?                  @map("created_by") @db.Uuid
  createdAt                 DateTime                 @default(示例公司有限公司()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  deletedAt                 DateTime?                @map("deleted_at")
  organization              Organization             @relation(fields: [organizationId], references: [id])
  department                Department?              @relation("DepartmentMembers", fields: [departmentId], references: [id])
  managedDepartments        Department[]             @relation("DepartmentHead")
  manager                   User?                    @relation("UserManager", fields: [managerId], references: [id])
  reports                   User[]                   @relation("UserManager")
  profile                   EmployeeProfile?
  roles                     UserRole[]
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]               @relation("AuditActor")
  ownedProjects             Project[]                @relation("ProjectOwner")
  supervisedProjects        Project[]                @relation("ProjectSupervisor")
  projectApprovals          ProjectApproval[]
  publishedProjects         Project[]                @relation("ProjectPublisher")
  skills                    EmployeeSkill[]
  capacities                EmployeeCapacity[]
  projectApplications       ProjectApplication[]     @relation("ApplicationApplicant")
  decidedApplications       ProjectApplication[]     @relation("ApplicationDecision")
  projectMemberships        ProjectMember[]
  submittedDeliveries       ProjectDelivery[]
  deliveryAcceptances       DeliveryAcceptance[]     @relation("AcceptanceReviewer")
  confirmedRatings          ProjectRating[]          @relation("RatingConfirmer")
  contributions             ProjectContribution[]    @relation("ContributionUser")
  proposedContributions     ProjectContribution[]    @relation("ContributionProposer")
  raisedDisputes            ContributionDispute[]    @relation("DisputeRaiser")
  arbitratedDisputes        ContributionDispute[]    @relation("DisputeArbitrator")
  bonusLedgers              BonusLedger[]
  reputationEvents          ReputationEvent[]
  restrictions              UserRestriction[]
  verifiedSkills            EmployeeSkill[]          @relation("SkillVerifier")
  capabilityHistory         CapabilityLevelHistory[] @relation("CapabilityEmployee")
  approvedCapabilityHistory CapabilityLevelHistory[] @relation("CapabilityApprover")
  skillEvidence             ProjectSkillEvidence[]   @relation("SkillEvidenceEmployee")
  reviewedSkillEvidence     ProjectSkillEvidence[]   @relation("SkillEvidenceReviewer")
  notifications             Notification[]
  businessRequests          BusinessRequest[]
  aiWorkspaceSessions       AIWorkspaceSession[]
  knowledgeAssets           KnowledgeAsset[]
  knowledgeAssetReviews     KnowledgeAssetReview[]
  confirmedProjectPlans     ProjectPlan[]             @relation("PlanConfirmer")
  sentTeamInvitations       ProjectTeamInvitation[]   @relation("InvitationSender")
  receivedTeamInvitations   ProjectTeamInvitation[]   @relation("InvitationRecipient")
  traineeProfile            TraineeProfile?          @relation("TraineeUser")
  mentoredTrainees           TraineeProfile[]         @relation("TraineeMentor")
  traineeReviews            TraineeReview[]

  @@unique([organizationId, email])
  @@index([organizationId, departmentId])
  @@index([organizationId, status, deletedAt])
  @@map("users")
}

model EmployeeProfile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @map("user_id") @db.Uuid
  capabilityLevel CapabilityLevel @default(L0) @map("capability_level")
  reputationScore Int             @default(100) @map("reputation_score")
  timezone        String          @default("Asia/Shanghai")
  bio             String?
  createdAt       DateTime        @default(示例公司有限公司()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("employee_profiles")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  code           String
  name           String
  description    String?
  isSystem       Boolean          @default(false) @map("is_system")
  status         EntityStatus     @default(ACTIVE)
  createdAt      DateTime         @default(示例公司有限公司()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  users          UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  createdAt   DateTime         @default(示例公司有限公司()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(示例公司有限公司()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(示例公司有限公司()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model SystemSetting {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  scope          String                  @default("GLOBAL")
  key            String
  value          Json
  version        Int                     @default(1)
  description    String?
  createdBy      String?                 @map("created_by") @db.Uuid
  createdAt      DateTime                @default(示例公司有限公司()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  organization   Organization            @relation(fields: [organizationId], references: [id])
  revisions      SystemSettingRevision[]

  @@unique([organizationId, scope, key])
  @@map("system_settings")
}

model SystemSettingRevision {
  id          String        @id @default(uuid()) @db.Uuid
  settingId   String        @map("setting_id") @db.Uuid
  version     Int
  value       Json
  changedById String?       @map("changed_by_id") @db.Uuid
  reason      String
  createdAt   DateTime      @default(示例公司有限公司()) @map("created_at")
  setting     SystemSetting @relation(fields: [settingId], references: [id])

  @@unique([settingId, version])
  @@map("system_setting_revisions")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  data       Json?
  dedupeKey  String?          @unique @map("dedupe_key")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(示例公司有限公司()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  action         String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime     @default(示例公司有限公司()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model BusinessRequest {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  requesterId       String                @map("requester_id") @db.Uuid
  linkedProjectId   String?               @unique @map("linked_project_id") @db.Uuid
  title             String
  problem           String
  businessContext   String                @map("business_context")
  expectedOutcome   String                @map("expected_outcome")
  constraints       String?
  status            BusinessRequestStatus @default(DRAFT)
  diagnosis         Json?
  createdAt         DateTime              @default(示例公司有限公司()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  organization      Organization          @relation(fields: [organizationId], references: [id])
  requester         User                  @relation(fields: [requesterId], references: [id])
  linkedProject     Project?              @relation(fields: [linkedProjectId], references: [id])
  workspaceSessions AIWorkspaceSession[]
  knowledgeAssets   KnowledgeAsset[]

  @@index([organizationId, requesterId, status])
  @@map("business_requests")
}

model AIWorkspaceSession {
  id              String               @id @default(uuid()) @db.Uuid
  requestId       String               @map("request_id") @db.Uuid
  createdById     String               @map("created_by_id") @db.Uuid
  status          AIWorkspaceStatus    @default(ACTIVE)
  provider        String?
  model           String?
  result          Json?
  originalResult  Json?                @map("original_result")
  confirmedResult Json?                @map("confirmed_result")
  error           String?
  createdAt       DateTime             @default(示例公司有限公司()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  completedAt     DateTime?            @map("completed_at")
  request         BusinessRequest      @relation(fields: [requestId], references: [id])
  createdBy       User                 @relation(fields: [createdById], references: [id])
  messages        AIWorkspaceMessage[]
  knowledgeAssets KnowledgeAsset[]

  @@index([requestId, createdAt])
  @@map("ai_workspace_sessions")
}

model AIWorkspaceMessage {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @map("session_id") @db.Uuid
  role      AIMessageRole
  content   String
  metadata  Json?
  idempotencyKey  String?            @map("idempotency_key")
  replyToId       String?            @map("reply_to_id") @db.Uuid
  generationStatus AIGenerationStatus @default(NONE) @map("generation_status")
  generationError String?            @map("generation_error")
  provider        String?
  model           String?
  promptVersion   String?            @map("prompt_version")
  latencyMs       Int?               @map("latency_ms")
  createdAt DateTime           @default(示例公司有限公司()) @map("created_at")
  session   AIWorkspaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replyTo   AIWorkspaceMessage?  @relation("WorkspaceMessageReplies", fields: [replyToId], references: [id])
  replies   AIWorkspaceMessage[] @relation("WorkspaceMessageReplies")

  @@index([sessionId, createdAt])
  @@unique([sessionId, idempotencyKey])
  @@index([replyToId])
  @@map("ai_workspace_messages")
}

model KnowledgeAsset {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  authorId       String                 @map("author_id") @db.Uuid
  requestId      String?                @map("request_id") @db.Uuid
  sessionId      String?                @map("session_id") @db.Uuid
  title          String
  summary        String
  content        Json
  assetType      KnowledgeAssetType     @default(PLAYBOOK) @map("asset_type")
  sourceUrl      String?                @map("source_url")
  usageCount     Int                    @default(0) @map("usage_count")
  status         KnowledgeAssetStatus   @default(DRAFT)
  createdAt      DateTime               @default(示例公司有限公司()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  publishedAt    DateTime?              @map("published_at")
  organization   Organization           @relation(fields: [organizationId], references: [id])
  author         User                   @relation(fields: [authorId], references: [id])
  request        BusinessRequest?       @relation(fields: [requestId], references: [id])
  session        AIWorkspaceSession?    @relation(fields: [sessionId], references: [id])
  reviews        KnowledgeAssetReview[]
  usageEvents    KnowledgeAssetUsageEvent[]

  @@index([organizationId, status, createdAt])
  @@map("knowledge_assets")
}

model KnowledgeAssetUsageEvent {
  id             String         @id @default(uuid()) @db.Uuid
  assetId        String         @map("asset_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  actorId        String         @map("actor_id") @db.Uuid
  referenceType  String         @map("reference_type")
  referenceId    String         @map("reference_id") @db.Uuid
  idempotencyKey String         @map("idempotency_key")
  createdAt      DateTime       @default(示例公司有限公司()) @map("created_at")
  asset          KnowledgeAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([assetId, referenceType, referenceId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("knowledge_asset_usage_events")
}

model Opportunity {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  publisherId           String                @map("publisher_id") @db.Uuid
  publisherDepartmentId String?               @map("publisher_department_id") @db.Uuid
  title                 String
  description           String
  valueTags             String[]              @default([]) @map("value_tags")
  visibility            OpportunityVisibility @default(ORGANIZATION)
  status                OpportunityStatus     @default(OPEN)
  deadline              DateTime?
  createdAt             DateTime              @default(示例公司有限公司()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  proposals             OpportunityProposal[]
  followers             OpportunityFollow[]
  conversion            OpportunityConversion?
  @@index([organizationId, status, createdAt])
  @@map("opportunities")
}

model OpportunityFollow {
  opportunityId String      @map("opportunity_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  createdAt     DateTime    @default(示例公司有限公司()) @map("created_at")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@id([opportunityId, userId])
  @@map("opportunity_follows")
}

model OpportunityProposal {
  id            String                    @id @default(uuid()) @db.Uuid
  opportunityId String                    @map("opportunity_id") @db.Uuid
  proposerId    String                    @map("proposer_id") @db.Uuid
  title         String
  approach      String
  expectedValue String                    @map("expected_value")
  status        OpportunityProposalStatus @default(PENDING)
  createdAt     DateTime                  @default(示例公司有限公司()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  opportunity   Opportunity               @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  conversion    OpportunityConversion?
  @@index([opportunityId, proposerId])
  @@index([opportunityId, status])
  @@map("opportunity_proposals")
}

model OpportunityConversion {
  id                String              @id @default(uuid()) @db.Uuid
  opportunityId     String              @unique @map("opportunity_id") @db.Uuid
  proposalId        String              @unique @map("proposal_id") @db.Uuid
  businessRequestId String              @unique @map("business_request_id") @db.Uuid
  convertedById     String              @map("converted_by_id") @db.Uuid
  createdAt         DateTime            @default(示例公司有限公司()) @map("created_at")
  opportunity       Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  proposal          OpportunityProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  @@map("opportunity_conversions")
}

model Circle {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  ownerId               String            @map("owner_id") @db.Uuid
  ownerDepartmentId     String?           @map("owner_department_id") @db.Uuid
  title                 String
  topic                 String
  visibility            CircleVisibility  @default(ORGANIZATION)
  status                CircleStatus      @default(OPEN)
  opportunityId         String?           @map("opportunity_id") @db.Uuid
  businessRequestId     String?           @map("business_request_id") @db.Uuid
  projectId             String?           @map("project_id") @db.Uuid
  closesAt              DateTime?         @map("closes_at")
  createdAt             DateTime          @default(示例公司有限公司()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  members               CircleMember[]
  joinRequests          CircleJoinRequest[]
