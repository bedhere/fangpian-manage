{
  "name": "agimax-handoff-dev",
  "services": {
    "postgres": {
      "image": "postgres:17-alpine",
      "environment": {
        "POSTGRES_DB": "valueflow",
        "POSTGRES_USER": "valueflow",
        "POSTGRES_PASSWORD": "dev-only-change-me"
      },
      "ports": [
        "127.0.0.1:15432:5432"
      ],
      "volumes": [
        "postgres:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U valueflow -d valueflow"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20
      }
    },
    "external-collab-postgres": {
      "image": "postgres:17-alpine",
      "environment": {
        "POSTGRES_DB": "external_collab",
        "POSTGRES_USER": "external_collab",
        "POSTGRES_PASSWORD": "dev-only-change-me"
      },
      "ports": [
        "127.0.0.1:15433:5432"
      ],
      "volumes": [
        "external:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U external_collab -d external_collab"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20
      }
    },
    "redis": {
      "image": "redis:7-alpine",
      "ports": [
        "127.0.0.1:16379:6379"
      ],
      "volumes": [
        "redis:/data"
      ],
      "command": [
        "redis-server",
        "--appendonly",
        "yes"
      ]
    },
    "minio": {
      "image": "valueflow-minio:local",
      "user": "0:0",
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "environment": {
        "MINIO_ROOT_USER": "handoff-dev",
        "MINIO_ROOT_PASSWORD": "dev-storage-change-me",
        "MINIO_API_CORS_ALLOW_ORIGIN": "http://localhost:3000,http://localhost:3002"
      },
      "ports": [
        "127.0.0.1:19000:9000",
        "127.0.0.1:19001:9001"
      ],
      "volumes": [
        "minio:/data"
      ]
    }
  },
  "volumes": {
    "postgres": {},
    "external": {},
    "redis": {},
    "minio": {}
  }
}